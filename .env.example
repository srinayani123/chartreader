# =============================================================================
# ChartReader environment variables
# Copy this file to `.env` and fill in real values.
# DO NOT commit `.env` — it's in .gitignore.
# =============================================================================

# -- Anthropic (required) --
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Models — defaults are reasonable; override only if you want to experiment
MODEL_VISION=claude-sonnet-4-5-20250929          # vision + reasoning
MODEL_REASONING=claude-sonnet-4-5-20250929       # final answer synthesis
MODEL_VERIFY=claude-haiku-4-5-20251001           # cheap verification step
MODEL_REFUSAL=claude-haiku-4-5-20251001          # cheap refusal classifier
MODEL_JUDGE=claude-sonnet-4-5-20250929           # eval-time LLM judge

# -- Tavily (required for news retrieval) --
TAVILY_API_KEY=tvly-your-key-here

# -- LangFuse (optional but recommended for observability) --
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# -- Postgres + pgvector (required for vector store) --
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=chartreader
PG_USER=postgres
PG_PASSWORD=chartreader

# -- Behavior tuning --
TEMPERATURE=0.2
MAX_AGENT_ITERATIONS=8
NEWS_CACHE_DAYS=30
EVAL_TEST_SET_PATH=eval/test_set
LOG_LEVEL=INFO
